<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="gp7_robot">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import gp7_robot urdf file -->
    <xacro:include filename="$(find gp7_visualization)/urdf/gp7_robot.urdf.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="gp7_robot.ros2_control.xacro" />


    <xacro:gp7_robot_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
